{
    "plugins": ["@prettier/plugin-php", "@trivago/prettier-plugin-sort-imports"],
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "all",
    "tabWidth": 4,
    "importOrder": [
        "\\.global\\.s?css$",
        "<THIRD_PARTY_MODULES>",
        "^[./](.*)?/(utils|hooks|lib)",
        "^[./].*(?<!(\\.[a-z]+))$",
        "\\.s?css$",
        "\\.[a-z]+$"
    ],
    "importOrderSeparation": true,
    "overrides": [
        {
            "files": "*.svg",
            "options": {
                "parser": "html"
            }
        }
    ]
}
